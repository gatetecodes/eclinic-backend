<table
  role="presentation"
  width="100%"
  cellpadding="0"
  cellspacing="0"
  style="border-collapse: collapse; font-family: Arial, Helvetica, sans-serif;"
>
  <tr>
    <td style="padding: 0 0 24px; text-align: left;">
      <img
        src="https://usecarelogic.com/assets/carelogic_logo.svg"
        alt="{{logoAlt}}"
        style="max-width: 200px; height: auto; display: block;"
      />
    </td>
  </tr>
  <tr>
    <td style="padding: 16px 0;">
      <p style="margin: 0 0 12px; font-size: 14px; color: #444;">{{greeting}}</p>
      <h2 style="margin: 0 0 8px; font-size: 20px; color: #111;">{{title}}</h2>
      <p style="margin: 0; font-size: 14px; color: #444;">{{clinicLabel}}:
        {{clinicName}}</p>
      <p style="margin: 8px 0 16px; font-size: 14px; color: #444;">
        {{intro}}
      </p>
    </td>
  </tr>
</table>

<table
  width="100%"
  cellpadding="0"
  cellspacing="0"
  style="border-collapse: collapse; font-family: Arial, Helvetica, sans-serif;"
>
  <thead>
    <tr>
      <th
        align="left"
        style="padding: 8px; border-bottom: 1px solid #ddd;"
      >{{itemLabel}}</th>
      <th
        align="left"
        style="padding: 8px; border-bottom: 1px solid #ddd;"
      >{{batchLabel}}</th>
      <th
        align="left"
        style="padding: 8px; border-bottom: 1px solid #ddd;"
      >{{expiryDateLabel}}</th>
      <th align="left" style="padding: 8px; border-bottom: 1px solid #ddd;">{{daysRemainingLabel}}</th>
      <th
        align="left"
        style="padding: 8px; border-bottom: 1px solid #ddd;"
      >{{quantityLabel}}</th>
    </tr>
  </thead>
  <tbody>
    {{#each batches}}
      <tr>
        <td
          style="padding: 8px; border-bottom: 1px solid #eee;"
        >{{itemName}}</td>
        <td
          style="padding: 8px; border-bottom: 1px solid #eee;"
        >{{batchNumber}}</td>
        <td
          style="padding: 8px; border-bottom: 1px solid #eee;"
        >{{expiryDate}}</td>
        <td
          style="padding: 8px; border-bottom: 1px solid #eee;"
        >{{daysUntilExpiry}}</td>
        <td
          style="padding: 8px; border-bottom: 1px solid #eee;"
        >{{quantity}}</td>
      </tr>
    {{/each}}
  </tbody>
</table>

<p
  style="font-family: Arial, Helvetica, sans-serif; font-size: 13px; color: #666; margin-top: 24px;"
>
  {{footerText}}
</p>
<p
  style="font-family: Arial, Helvetica, sans-serif; font-size: 13px; color: #444; margin: 0;"
>
  {{signatureText}}<br />
  {{teamText}}
</p>
