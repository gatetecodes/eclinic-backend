<html>
  <head>
    <meta charset="utf-8" />
    <title>{{previewTitle}}</title>
  </head>
  <body style="font-family: Arial, sans-serif; line-height: 1.6; color: #333;">
    <div style="max-width: 600px; margin: 0 auto; padding: 20px;">
      <h2 style="color: #233956;">{{title}}</h2>

      <div style="margin-top: 20px;">
        <p>{{greeting}}</p>

        <p>{{body}}</p>

        <p>{{nextText}}</p>

        <p>{{thanksText}}</p>

        <p>{{questionsText}}</p>
        <ul style="list-style: none; padding-left: 0;">
          <li>{{phoneLabel}}: +250 789759638</li>
          <li>{{emailLabel}}: support@usecarelogic.com</li>
        </ul>
      </div>

      <div style="margin-top: 30px;">
        <p>{{signatureText}}<br />{{teamText}}</p>
      </div>
    </div>
  </body>
</html>
