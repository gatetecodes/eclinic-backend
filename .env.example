# Database
DATABASE_URL="postgresql://username:password@localhost:5432/eclinic"

# Better-Auth
BETTER_AUTH_SECRET="your-secret-key-here"
BETTER_AUTH_URL="http://localhost:3001"

# OAuth Providers
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Frontend URL
FRONTEND_URL="http://localhost:3000"

# Redis (for caching)
REDIS_URL="redis://localhost:6379"

# Email (Resend)
RESEND_API_KEY="your-resend-api-key"

# File Storage (Cloudflare R2)
CLOUDFLARE_ACCOUNT_ID="your-account-id"
CLOUDFLARE_ACCESS_KEY_ID="your-access-key"
CLOUDFLARE_SECRET_ACCESS_KEY="your-secret-key"
CLOUDFLARE_BUCKET_NAME="your-bucket-name"

# Socket.io
SOCKET_API_SECRET="your-socket-secret"

# Cron Jobs
CRON_SECRET_KEY="your-cron-secret"

# Environment
NODE_ENV="development"
PORT=3001

# Rwanda HIE (backend only — never expose these as NEXT_PUBLIC variables)
HIE_DEPLOYMENT_ENVIRONMENT="TEST"
HIE_ENDPOINT_ENVIRONMENT="TEST"
HIE_CREDENTIAL_ENVIRONMENT="TEST"
HIE_CLIENT_REGISTRY_BASE_URL=""
HIE_SHR_BASE_URL=""
# Non-FHIR NIDA citizen lookup (POST /getCitizen). Its own base, e.g. .../api/v1/citizens/
HIE_CITIZEN_BASE_URL=""
# National Facility Registry through openHIM, e.g. https://<gateway>/facility-registry/
# Unset disables registry search and verification; the console falls back to manual attestation.
HIE_FACILITY_REGISTRY_BASE_URL=""
# National Provider Registry. UNSET until MoH publishes an openHIM route: do NOT point this
# at the direct host (http://10.10.69.42:9095) — this client sends HTTP basic auth, not
# x-auth-token, and rejects plain HTTP outside TEST.
HIE_PROVIDER_REGISTRY_BASE_URL=""
# Pin the identifier.system that carries the FOSA code once MoH confirms it. Until then the
# sync falls back to a heuristic and logs the systems it observed.
HIE_FACILITY_REGISTRY_FOSA_SYSTEM=""
# Facility directory sync. Page size stays small so a page fits the response cap.
HIE_FACILITY_DIRECTORY_PAGE_LIMIT=500
HIE_FACILITY_DIRECTORY_MAX_PAGES=40
# How long a snapshot is considered fresh, and the floor between sweeps.
HIE_FACILITY_DIRECTORY_TTL_HOURS=24
HIE_FACILITY_DIRECTORY_MIN_SYNC_INTERVAL_MINUTES=15
# How long a registry-granted verification stands before it must be re-checked.
HIE_REGISTRY_VERIFICATION_TTL_DAYS=90
HIE_BASIC_AUTH_USERNAME=""
HIE_BASIC_AUTH_PASSWORD=""
# 32 random bytes encoded as 64 hex characters or base64
HIE_DATA_ENCRYPTION_KEY=""
# Separate stable 32-byte HMAC key; rotating the encryption key must not change uniqueness hashes.
HIE_IDENTIFIER_HASH_KEY=""
HIE_REQUEST_TIMEOUT_MS=8000
# Safe GET requests retry transient network, 429, and 5xx failures. Range: 1-4.
HIE_GET_MAX_ATTEMPTS=3
# Initial GET retry delay in milliseconds; subsequent delays use exponential backoff.
HIE_GET_RETRY_BASE_MS=250
# Operations alert threshold for unresolved publication events. Range: 5-1440 minutes.
HIE_ALERT_STALE_MINUTES=30
# Test environment only. Production rejects plain HTTP even when this is true.
HIE_ALLOW_INSECURE_TEST=false
