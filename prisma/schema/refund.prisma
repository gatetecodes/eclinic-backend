model Refund {
    id                        Int         @id @default(autoincrement())
    clinic                    Clinic      @relation(fields: [clinicId], references: [id])
    clinicId                  Int
    payment                   Payment     @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
    paymentId                 Int
    visit                     Visit       @relation(fields: [visitId], references: [id], onDelete: Restrict, onUpdate: Cascade)
    visitId                   Int
    examResult                ExamResult? @relation(fields: [examResultId], references: [id], onDelete: Restrict, onUpdate: Cascade)
    examResultId              Int?
    product                   Product     @relation(fields: [productId], references: [id])
    productId                 Int
    approval                  Approval?   @relation(fields: [approvalId], references: [id])
    approvalId                Int?
    patientRefundAmount       Decimal     @db.Decimal(10, 2)
    insuranceAdjustmentAmount Decimal     @db.Decimal(10, 2)
    totalAdjustmentAmount     Decimal     @db.Decimal(10, 2)
    reason                    String?
    refundedBy                User?       @relation("ProcessedRefunds", fields: [refundedById], references: [id])
    refundedById              Int?
    createdAt                 DateTime    @default(now())
    updatedAt                 DateTime    @updatedAt

    @@unique([paymentId, examResultId, productId])
    @@index([clinicId])
    @@index([paymentId])
    @@index([visitId])
    @@index([examResultId])
    @@index([productId])
    @@index([refundedById])
}
